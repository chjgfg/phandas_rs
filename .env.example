# 本地环境配置模板。复制成 `.env` 后按需改；`.env` 已在 .gitignore 里，不会入库。
#
#   cp .env.example .env
#
# 服务器上**不要**放 .env —— 文件不存在时 load_default_dotenv() 什么都不做，于是直连。
# 已存在的真实环境变量优先于本文件，所以 `HTTPS_PROXY= cargo test ...` 能临时压过它。

# 走代理才能访问交易所时打开（改成你自己的地址）
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897

# 阶段 2（trader / OKX 下单）会用到，现在留空。切记：只填模拟盘的凭证做验收。
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
